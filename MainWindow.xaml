<Window x:Class="RetailFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RetailFlow"
        mc:Ignorable="d"
        Title="MiniMart Manager - Retail Inventory &amp; Sales Management System"
        Height="650" Width="1000" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="#1F2937">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,30">
                    <TextBlock Text="MiniMart Manager" FontSize="22" FontWeight="Bold"
                               Foreground="White" Margin="20,0,0,4"/>
                    <TextBlock Text="Inventory &amp; Sales" FontSize="11"
                               Foreground="#9CA3AF" Margin="20,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnDashboard" Content="Dashboard"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Click="BtnDashboard_Click"/>
                    <Button x:Name="BtnProducts" Content="Products"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnProducts_Click"/>
                    <Button x:Name="BtnSales" Content="New Sale"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnSales_Click"/>
                    <Button x:Name="BtnTransactions" Content="Transactions"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnTransactions_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <Grid Grid.Column="1" Background="#F3F4F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="24,16"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <TextBlock x:Name="PageTitle" Text="Dashboard"
                           FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>
