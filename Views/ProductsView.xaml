<UserControl x:Class="RetailFlow.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: search toolbar + product list -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" Grid.Column="0"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>

                <CheckBox x:Name="ShowInactiveCheckBox" Grid.Column="1"
                          Content="Show inactive"
                          IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>

                <CheckBox x:Name="LowStockOnlyCheckBox" Grid.Column="2"
                          Content="Low stock only"
                          IsChecked="{Binding LowStockOnly}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button x:Name="NewProductButton" Grid.Column="3"
                        Content="+ New Product"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewProductCommand}"/>
            </Grid>

            <Grid Grid.Row="1">
                <DataGrid x:Name="ProductsDataGrid"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F1F3"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="#E5E7EB"
                          Background="White"
                          AlternatingRowBackground="#FAFBFC"
                          RowHeight="36"
                          FontSize="13"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='Rs. {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="60"/>
                        <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="70"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,3" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Setter Property="Text" Value="Active"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Setter Property="Text" Value="Inactive"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <TextBlock Text="No products found. Try a different search, or add a new product to get started."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="280" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProducts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- RIGHT: add / edit form -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="📦" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionHeadingStyle}" Margin="0"/>
                </StackPanel>

                <TextBlock Text="Product Code" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductCodeTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormProductCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Product Name" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductNameTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Category" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductCategoryTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Price (Rs.)" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductPriceTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Stock Quantity" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductStockTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormStockQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Reorder Level" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="ProductReorderTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding FormReorderLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#16A34A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="SaveProductButton" Content="Save"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="CancelProductButton" Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>

                <Button x:Name="ToggleActiveButton" Content="{Binding ToggleActiveButtonText}"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding ToggleActiveCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
