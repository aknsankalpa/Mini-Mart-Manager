<UserControl x:Class="RetailFlow.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: search/filter + transaction list -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TransactionSearchTextBox" Grid.Column="0"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>

                <TextBlock Grid.Column="1" Text="From" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Grid.Column="2"
                            SelectedDate="{Binding FromDate}" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="3" Text="To" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Grid.Column="4"
                            SelectedDate="{Binding ToDate}"/>
            </Grid>

            <Grid Grid.Row="1">
                <DataGrid x:Name="TransactionsDataGrid"
                          ItemsSource="{Binding Transactions}"
                          SelectedItem="{Binding SelectedTransaction}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F1F3"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="#E5E7EB"
                          Background="White"
                          AlternatingRowBackground="#FAFBFC"
                          RowHeight="36"
                          FontSize="13"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNumber}" Width="150"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='MMM dd, yyyy h:mm tt'}" Width="*"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat='Rs. {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rs. {0:N2}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No transactions found. Try a different search or date range."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="280" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTransactions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- RIGHT: receipt-style detail of the selected transaction -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <TextBlock Text="Select a transaction to view its details."
                           Style="{StaticResource EmptyStateTextStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="240" TextAlignment="Center"/>

                <Grid Background="White"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedTransaction.InvoiceNumber, StringFormat='Invoice #{0}'}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedTransaction.SaleDate, StringFormat='MMMM dd, yyyy h:mm tt'}"
                                   FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedTransactionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Product.Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,2,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} &#215; Rs. {1:N2} = Rs. {2:N2}">
                                                    <Binding Path="Quantity"/>
                                                    <Binding Path="UnitPrice"/>
                                                    <Binding Path="LineTotal"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13" Foreground="#374151"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.SubTotal, StringFormat='Rs. {0:N2}'}" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discount" FontSize="13" Foreground="#374151"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Discount, StringFormat='Rs. {0:N2}'}" FontSize="13"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Total, StringFormat='Rs. {0:N2}'}" FontSize="16" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
