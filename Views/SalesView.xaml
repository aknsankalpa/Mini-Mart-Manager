<UserControl x:Class="RetailFlow.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: product search + add to cart -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SalesSearchTextBox" Grid.Row="0"
                     Style="{StaticResource FormTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <DataGrid x:Name="AvailableProductsDataGrid" Grid.Row="1"
                      ItemsSource="{Binding AvailableProducts}"
                      SelectedItem="{Binding SelectedProduct}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F1F3"
                      HeadersVisibility="Column"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      Background="White"
                      RowHeight="36"
                      FontSize="13"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='Rs. {0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="In Stock" Binding="{Binding StockQuantity}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Quantity" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="13" Foreground="#374151"/>

                <TextBox x:Name="QuantityTextBox" Grid.Column="1"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>

                <Button x:Name="AddToCartButton" Grid.Column="2"
                        Content="Add to Cart"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddToCartCommand}"/>
            </Grid>
        </Grid>

        <!-- RIGHT: current sale (cart + checkout) -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Current Sale" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <DataGrid x:Name="CartDataGrid" Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F1F3"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="#E5E7EB"
                          RowHeight="34"
                          FontSize="12"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" Width="80"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="40"/>
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="85"/>
                        <DataGridTemplateColumn Header="" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#10005;"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#DC2626" Cursor="Hand" FontSize="11"
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13" Foreground="#374151"/>
                        <TextBlock x:Name="SubtotalText" Grid.Column="1"
                                   Text="{Binding Subtotal, StringFormat='Rs. {0:N2}'}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount (Rs.)" VerticalAlignment="Center" FontSize="13" Foreground="#374151"/>
                        <TextBox x:Name="DiscountTextBox" Grid.Column="1"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalText" Grid.Column="1"
                                   Text="{Binding Total, StringFormat='Rs. {0:N2}'}" FontSize="16" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock x:Name="SalesStatusMessageText" Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button x:Name="CompleteSaleButton" Content="Complete Sale"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CompleteSaleCommand}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
